# --- Supabase ---
# Project Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Google Gemini (free tier) ---
# Create a key at https://aistudio.google.com/apikey
# Never expose this one with NEXT_PUBLIC_ — it's only read on the server (see app/api/ai/*).
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the model without touching code. Google renames/retires models
# fairly often — check https://ai.google.dev/gemini-api/docs/models if this stops working.
GEMINI_MODEL=gemini-3.1-flash-lite

# --- WebRTC (optional but recommended) ---
# Public STUN is baked in and free, but STUN alone can fail to connect two peers on
# strict/symmetric NATs (common on college wifi/hostel networks). A TURN server fixes
# that. Free options: https://www.metered.ca/tools/openrelay/ or Cloudflare Calls.
# Leave blank to fall back to STUN-only (works most of the time, not guaranteed).
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
